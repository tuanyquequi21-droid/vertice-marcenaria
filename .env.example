# PostgreSQL connection string from Supabase: Project Settings > Database > Connection string
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Supabase project URL and keys
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Generate a long random secret for Flask sessions
FLASK_SECRET_KEY=change-me-to-a-long-random-secret
